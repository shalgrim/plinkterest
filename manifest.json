{
  "manifest_version": 3,
  "name": "Pinterest Link Opener",
  "version": "1.0.0",
  "description": "Opens all pins from a Pinterest board in new tabs",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.pinterest.com/*",
    "https://pinterest.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pinterest.com/*",
        "https://pinterest.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
